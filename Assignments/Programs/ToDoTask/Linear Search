#include<stdio.h>
void main(){
int i,n;
int a[i],key,found=0;
printf("enter size:");
scanf("%d",&n);
printf("enter values:");
for(i=0;i<n;i++){
scanf("%d",&a[i]);
}
printf("enter key value:");
scanf("%d",&key);
for(i=0;i<=n;i++)
if(key==a[i]){
found=1;
break;
}
if(found)
printf("element found at location:%d",i);
else{
    printf("key not found");
}
return;
}
